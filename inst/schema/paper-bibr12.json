{
  "description": "What a paper read from a bibr export schema 12.x file (12.6 adds what a publisher's XML declares) (or converted from Grobid TEI with schema_version = \"12.0\") adds to paper.json. Every addition is optional, so papers in the older format validate as before. Merged into paper.json by .paper_schema_bibr12().",
  "properties": {
    "affiliation": {
      "description": "bibr 12.x: distinct byline affiliations (the 12.x name of affiliations)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/affiliation"
      }
    },
    "footnote": {
      "description": "bibr 12.x: one row per footnote or endnote; its text is a row of the text table with no section",
      "type": "array",
      "items": {
        "$ref": "#/$defs/footnote"
      }
    },
    "affiliation_match": {
      "description": "bibr 12.x: ROR organizations matched to affiliation strings",
      "type": "array",
      "items": {
        "$ref": "#/$defs/affiliation_match"
      }
    },
    "funding_match": {
      "description": "bibr 12.x: ROR organizations matched to printed funder names",
      "type": "array",
      "items": {
        "$ref": "#/$defs/funding_match"
      }
    },
    "subject": {
      "description": "bibr 12.6: subject terms with their scheme (subject headings, JEL codes, open-science badges, assessment terms)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "related": {
      "description": "bibr 12.6: works the input declares related (corrected or retracted articles, the preprint, peer-review reports)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/related"
      }
    },
    "contributor": {
      "description": "bibr 12.6: editors and reviewers, who are not authors",
      "type": "array",
      "items": {
        "$ref": "#/$defs/contributor"
      }
    },
    "supplement": {
      "description": "bibr 12.6: supplementary files the input lists",
      "type": "array",
      "items": {
        "$ref": "#/$defs/supplement"
      }
    },
    "review": {
      "description": "bibr 12.6: peer-review documents (decision letters, referee reports, author responses, assessments)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "review_text": {
      "description": "bibr 12.6: paragraphs of the peer-review documents, kept apart from the paper's text table",
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_text"
      }
    }
  },
