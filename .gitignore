# metacheck's on-disk caches (downloaded repository files and LLM responses).
# Created in the working directory when a lasting cache is asked for
# (cache = TRUE, llm_cache(TRUE)); see metacheck_cache_info() to locate them or
# the metacheck.cache.dir option to move them elsewhere.
#
# Only ignored at the repository root. NOT a blanket `.metacheck_*`: the folder
# tests/testthat/.metacheck_repo_cache holds COMMITTED ResearchBox fixtures that
# a blanket pattern would hide, so a future deletion of them would go unnoticed.
/.metacheck_repo_cache/
/.metacheck_llm_cache/
/.metacheck_repo_info_cache/
/.metacheck_zip_peek_cache/

# testthat writes a copy of each failing test here, to help find the fault
/tests/testthat/_problems/

.comments/

# scratch output from local scripts (e.g. data-raw/report-all-types.R) --
# never committed, regenerate by re-running the script that made it
/tmp_output/
