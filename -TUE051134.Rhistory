install_missing = TRUE,    # <- auto-install packages
timeout         = 600,
keep_sandbox    = TRUE     # keep the temp run dir so you can inspect it
)
# ── The module chain ──────────────────────────────────────────────────────────
# Order matters: reproducibility_check reads the outputs of the modules before
# it, so they must precede it in this vector.
repro_modules <- c("stat_check", "open_practices", "stat_p_nonsig",
"marginal", "stat_p_exact", "stat_effect_size",
"power", "prereg_check", "ethics_check", "funding_check",
"coi_check", "coi_check_oi", "repo_check",
"data_check", "psychds_check", "code_check", "excel_check",
"codebook_check", "data_validate", "reproducibility_check")
# ── Load the corpus and resolve the selected paper ────────────────────────────
corpus  <- "collabra"
papers  <- papers_load(corpus, cache = TRUE)
message("Loaded ", length(papers), " papers from the ", corpus, " corpus.")
all_ids <- names(papers) %||% vapply(papers, paper_id, character(1))
pid <- if (is.numeric(TEST_PAPER)) all_ids[[TEST_PAPER]] else TEST_PAPER
if (is.na(pid) || !pid %in% all_ids)
stop("No such paper: ", TEST_PAPER, call. = FALSE)
paper <- papers[[pid]]
# ── Run the chain (this is the top-level action) ──────────────────────────────
# report_module_run() folds the modules together and returns a list keyed by
# module name; we pull reproducibility_check out of it.
message("\n── running the chain for ", pid, " ──")
module_output <- report(
paper, repro_modules, args = list(data_check = data_check_args,
reproducibility_check = reproducibility_check_args))
repro <- module_output[["reproducibility_check"]]
# convert_psychds() returns a list whose $output_dir is the paper's Psych-DS
# folder (e.g. .../psychds/collabra.72) — that folder is the collection_root to
# hand to add_to_scienceverse(). Capture the return; do NOT reference an
# unassigned `psychds`.
psychds <- convert_psychds(module_output)
add_to_scienceverse(psychds$output_dir, db_path = SV_DB, rebuild_fts = FALSE)
m <- match_reported_output(paper, module_output$stat_output)
attr(m, "summary")
message("\n── reproducibility_check for ", pid, " ──")
message("traffic light: ", repro$traffic_light)
message(repro$summary_text)
message("\nPer-file table:")
print(repro$table)
# The rendered report section (markdown) for this module, if you want to see it:
# cat(module_report(repro), sep = "\n")
# ─────────────────────────────────────────────────────────────────────────────
# Try out the new reproducibility_check on ONE Collabra paper.
#
# reproducibility_check performs STATIC analysis only (execute = FALSE; it does
# not run any code yet). It reads the outputs of three upstream modules:
#   * data_check      — downloads the readable repo files and records their
#                       on-disk location (its `structure` table);
#   * psychds_check    — the file → Psych-DS target plan the path-rewrite uses;
#   * code_check      — the code files + per-file parse/package analysis.
# So those three MUST run, and run BEFORE it, for the check to have its inputs.
#
# The modules pass their output forward by folding: report_module_run() feeds
# each module's output in as the next module's `paper`, which is the mechanism
# reproducibility_check uses (via get_prev_outputs) to see the upstream results.
# That is why we call report_module_run() and NOT module_run() in a loop —
# module_run() runs a single module and does not chain.
#
# HOW TO USE:  edit TEST_PAPER below, then either
#              - source this file in RStudio, or
#              - Rscript _stuff/run_repro_collabra.R
# It prints reproducibility_check's traffic light, summary, and per-file table.
# ─────────────────────────────────────────────────────────────────────────────
setwd("C:/Users/dlakens/OneDrive - TU Eindhoven/git_repos/metacheck")
SV_DB <- "C:/Users/dlakens/OneDrive - TU Eindhoven/scienceverse/scienceverse.sqlite"
devtools::load_all()
trace(utils::read.table, tracer = quote({
f <- tryCatch(as.character(file)[1], error = function(e) "?")
if (grepl("\\.(docx|pdf|sav|xls|xlsx)$", f, ignore.case = TRUE)) {
message("\n>>> read.table on: ", f)
print(sys.calls())
}
}), print = FALSE)
# ── Which paper to test ───────────────────────────────────────────────────────
# A position in the corpus (a number), or a paper id (a string like
# "collabra.123"). Edit this one line to change the paper.
TEST_PAPER <- 509
# ── LLM ───────────────────────────────────────────────────────────────────────
# The upstream data_check / psychds_check use the LLM for study grouping (which
# the per-study path rewrite relies on). Responses are cached (deterministic at
# temperature 0). Set llm_use(FALSE) for a rule-only run (faster/cheaper; the
# path rewrite then falls back to filename-only grouping).
llm_use(TRUE)
llm_cache(TRUE)
llm_max_calls(100)
llm_model("groq/openai/gpt-oss-20b")
# install.packages() (used when reproducibility_check installs missing deps) falls
# back to getOption("repos"); in a plain Rscript session that is the unresolved
# "@CRAN@" placeholder, which hangs/prompts non-interactively. Set a concrete
# mirror once for this session so installs go straight through.
if (any(getOption("repos") == "@CRAN@"))
options(repos = c(CRAN = "https://cloud.r-project.org"))
# ── Download settings (passed to data_check) ──────────────────────────────────
# reproducibility_check needs the CODE files on disk to read them, and benefits
# from the data files being present so it can tell "missing input" from "file is
# actually here". cache = TRUE puts downloads in the persistent on-disk cache so
# re-runs reuse them. Keep the size caps generous so real data is not withheld
# (a withheld input turns the light red — that is the size-cap story, on purpose).
data_check_args <- list(
download          = "all",
skip_types        = "asset",     # never fetch stimuli/media
peek_zips         = TRUE,        # look inside zips, fetch only data/code zips
max_file_size     = 100,        # MB per file
max_download_size = 500,        # MB total per repo
cache             = TRUE)
reproducibility_check_args <- list(
execute         = TRUE,
install_missing = TRUE,    # <- auto-install packages
timeout         = 600,
keep_sandbox    = TRUE     # keep the temp run dir so you can inspect it
)
# ── The module chain ──────────────────────────────────────────────────────────
# Order matters: reproducibility_check reads the outputs of the modules before
# it, so they must precede it in this vector.
repro_modules <- c("stat_check", "open_practices", "stat_p_nonsig",
"marginal", "stat_p_exact", "stat_effect_size",
"power", "prereg_check", "ethics_check", "funding_check",
"coi_check", "coi_check_oi", "repo_check",
"data_check", "psychds_check", "code_check", "excel_check",
"codebook_check", "data_validate", "reproducibility_check")
# ── Load the corpus and resolve the selected paper ────────────────────────────
corpus  <- "collabra"
papers  <- papers_load(corpus, cache = TRUE)
message("Loaded ", length(papers), " papers from the ", corpus, " corpus.")
all_ids <- names(papers) %||% vapply(papers, paper_id, character(1))
pid <- if (is.numeric(TEST_PAPER)) all_ids[[TEST_PAPER]] else TEST_PAPER
if (is.na(pid) || !pid %in% all_ids)
stop("No such paper: ", TEST_PAPER, call. = FALSE)
paper <- papers[[pid]]
# ── Run the chain (this is the top-level action) ──────────────────────────────
# report_module_run() folds the modules together and returns a list keyed by
# module name; we pull reproducibility_check out of it.
message("\n── running the chain for ", pid, " ──")
module_output <- report(
paper, repro_modules, args = list(data_check = data_check_args,
reproducibility_check = reproducibility_check_args))
repro <- module_output[["reproducibility_check"]]
# convert_psychds() returns a list whose $output_dir is the paper's Psych-DS
# folder (e.g. .../psychds/collabra.72) — that folder is the collection_root to
# hand to add_to_scienceverse(). Capture the return; do NOT reference an
# unassigned `psychds`.
psychds <- convert_psychds(module_output)
add_to_scienceverse(psychds$output_dir, db_path = SV_DB, rebuild_fts = FALSE)
